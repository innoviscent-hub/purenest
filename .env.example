# PureNest - Environment Variables Template
# Copy this file to a new file named .env before running the application

# The port number on which the backend server will run
PORT=5000

# Nodemailer Gmail SMTP Credentials
# EMAIL_USER should be the Gmail address that acts as both the sender and the recipient for website inquiries.
# EMAIL_PASS must be a Google App Password (not your primary account password).
# How to generate: Google Account Settings -> Security -> 2-Step Verification -> App Passwords
EMAIL_USER=example@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
